# PostgreSQL connection string used by the traveler storage API
# (saved places + last trip). Drizzle reads this in src/db/index.ts.
#
# The app builds WITHOUT this variable — `next build` no longer touches the
# database, so CI, Docker and static hosts can build freely. The variable is
# only required at runtime for /api/traveler/* persistence and /api/health.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: override upstream/public service endpoints
# NEXT_PUBLIC_APP_NAME=Mapa Wałbrzycha
# NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
# NEXT_PUBLIC_WALKING_OSRM_URL=https://routing.openstreetmap.de/routed-foot
# NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# NEXT_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
# NEXT_PUBLIC_BASE_URL=/
